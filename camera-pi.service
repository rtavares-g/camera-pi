[Unit]
Description=Visualizacao da camera via WebSocket
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=raspberry
Group=raspberry
SupplementaryGroups=video

WorkingDirectory=/home/raspberry/camera-pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/raspberry/camera-pi/venv/bin/python /home/raspberry/camera-pi/camera_pi.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
