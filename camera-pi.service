[Unit]
Description=Painel da camera (HLS do MediaMTX) + camera na Sinric Pro
After=network-online.target mediamtx.service
Wants=network-online.target mediamtx.service

[Service]
Type=simple
User=__USER__
Group=__USER__

WorkingDirectory=__HOME__/camera-pi
Environment=PYTHONUNBUFFERED=1
ExecStart=__HOME__/camera-pi/venv/bin/python __HOME__/camera-pi/camera_pi.py

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
