# Credenciais do SinricPro (https://portal.sinric.pro)
#   App Key / App Secret : menu Credentials (compartilhadas entre os dispositivos)
#   Device ID             : menu Devices, no dispositivo do tipo Camera
#                           (configurado como "RaspPi ou outro" + WebRTC)
SINRIC_APP_KEY=
SINRIC_APP_SECRET=
SINRIC_DEVICE_ID=

# Logs detalhados do SDK (1 para ligar)
SINRIC_DEBUG=0
