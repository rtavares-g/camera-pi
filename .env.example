# Credenciais do SinricPro (https://portal.sinric.pro)
#   App Key / App Secret : menu Credentials (compartilhadas entre os dispositivos)
#   Device ID             : menu Devices, no dispositivo do tipo Camera
#                           (configurado como "RaspPi ou outro" + WebRTC)
SINRIC_APP_KEY=
SINRIC_APP_SECRET=
SINRIC_DEVICE_ID=

# Logs detalhados do SDK (1 para ligar)
SINRIC_DEBUG=0

# Gravacao por movimento (todas opcionais; padroes abaixo)
# GRAVACOES_DIR=~/camera-gravacoes
# RETENCAO_DIAS=5
# POS_GRAVACAO=10      # segundos gravados depois do ultimo movimento
# MAX_EVENTO=600       # eventos maiores sao divididos em arquivos deste tamanho
# MIN_LIVRE_GB=5       # abaixo disso apaga as gravacoes mais antigas
