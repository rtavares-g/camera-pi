# Gravacao por movimento (todas opcionais; padroes abaixo)
# GRAVACOES_DIR=~/camera-gravacoes
# RETENCAO_DIAS=5
# POS_GRAVACAO=10      # segundos gravados depois do ultimo movimento
# MAX_EVENTO=600       # eventos maiores sao divididos em arquivos deste tamanho
# MIN_LIVRE_GB=5       # abaixo disso apaga as gravacoes mais antigas
